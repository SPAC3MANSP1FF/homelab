# Copy this file to update.env, edit the values, and keep the copied file private.
# It is sourced by ../update.sh as a Bash configuration file.

# Path to your Docker Compose directory
DOCKER_DIR=<PATH_TO_DOCKER_COMPOSE_DIRECTORY>

# User-specific paths and keys
USER_HOME="/home/<YOUR_USERNAME>"
REPO_DIR="$USER_HOME/<YOUR_PROJECT DIRECTORY>"
SSH_KEY_PATH="$USER_HOME/.ssh/<YOUR_SSH_KEY>"