# Copy this file to update.env, edit the values, and keep the copied file private.
# It is sourced by ../update.sh as a Bash configuration file.

# --- Repository & Multi-Stack Paths ---
# Space-separated list of local repository directories to pull and update
STACK_PATHS="/home/<YOUR_USERNAME>/homelab /home/<YOUR_USERNAME>/medialab"

# --- SSH Key Configuration ---
# Path to your private key used for git operations (if applicable)
SSH_KEY_PATH="/home/<YOUR_USERNAME>/.ssh/<YOUR_SSH_KEY>"