# Copy this file to backup.env, edit the values, and keep the copied file private.
# It is sourced by ../backup.sh as a Bash configuration file.

# --- Connection Settings ---
REMOTE_HOST=<REMOTE_SERVER_HOSTNAME_OR_IP>
REMOTE_USER=<SSH_USERNAME>

# --- Home Backup Paths ---
# Absolute path on the remote host where home backups will be stored
HOME_DEST=<PATH_TO_BACKUP_DIRECTORY>/<YOUR_USERNAME>
# Comma-separated list of local folders to back up (e.g., /home/user/Docs,/home/user/Desktop)
HOME_SOURCES=/home/<YOUR_USERNAME>/Documents,/home/<YOUR_USERNAME>/Desktop

# --- Media Backup Paths ---
# Base path on your local host containing your media folders
MEDIA_BASE=<PATH_TO_YOUR_MEDIA>
# Destination path on the remote host
MEDIA_DEST=<PATH_TO_BACKUP_DIRECTORY>
# Comma-separated list of media folders to back up
MEDIA_FOLDERS=<COMMA_SEPARATED_LIST> #e.g. Music,Pictures,Videos etc. that are folders in MEDIA_BASE

# --- Identity Mappings ---
# Used for rsync --usermap and --groupmap to ensure correct permissions on remote
BACKUP_USER=<REMOTE_USER_FOR_PERMISSIONS>
BACKUP_GROUP=<REMOTE_GROUP_FOR_PERMISSIONS>

# --- Docker Backup Paths ---
# The parent directory containing all your container data
DOCKER_APPDATA_PATH=#Default is /var/lib/docker/appdata
# Where you want to store these backups on the remote host
DOCKER_BACKUP_DEST=<PATH/TO/BACKUP/DIRECTORY> #This can be the same or different than MEDIA_DEST
DOCKER_COMPOSE_YAML=<PATH/TO/YOUR/compose.yaml>
SSH_KEY_PATH=<PATH_TO_YOUR_SSH_KEY> #e.g. /home/username/.ssh/id_ed12345