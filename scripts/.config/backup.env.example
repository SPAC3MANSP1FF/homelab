# Copy this file to backup.env, edit the values, and keep the copied file private.
# It is sourced by ../backup.sh as a Bash configuration file.

# --- Connection & Authentication Settings ---
REMOTE_HOST=<REMOTE_SERVER_HOSTNAME_OR_IP>
REMOTE_USER=<SSH_USERNAME>
SSH_KEY_PATH="/home/<YOUR_USERNAME>/.ssh/<YOUR_SSH_KEY>"

# --- Identity Mappings ---
# Used for rsync --usermap and --groupmap to ensure correct permissions on remote
BACKUP_USER=<REMOTE_USER_FOR_PERMISSIONS>
BACKUP_GROUP=<REMOTE_GROUP_FOR_PERMISSIONS>

# --- Multi-Stack Docker Configuration ---
# Space-separated list of paths to all docker-compose directories requiring safe database shutdowns
DOCKER_STACK_DIRS="/home/<YOUR_USERNAME>/homelab/docker-apps /home/<YOUR_USERNAME>/medialab/docker-apps"

# --- Docker Backup Paths ---
# Parent directory containing container persistent data
DOCKER_APPDATA_PATH=/var/lib/docker/appdata
# Target destination path on the remote host for appdata backups
DOCKER_BACKUP_DEST=<PATH/TO/REMOTE_BACKUP_DIRECTORY>

# --- General System / Home Backup Paths ---
# Comma-separated list of local home folders to back up
HOME_SOURCES=/home/<YOUR_USERNAME>/Documents,/home/<YOUR_USERNAME>/Desktop
# Absolute path on the remote host for home folder backups
HOME_DEST=<PATH_TO_REMOTE_BACKUP_DIRECTORY>/<YOUR_USERNAME>

# --- Media Backup Paths ---
# Base path on your local host containing media libraries
MEDIA_BASE=<PATH_TO_YOUR_LOCAL_MEDIA>
# Comma-separated list of media subdirectories to back up (e.g., Music,Pictures,Videos)
MEDIA_FOLDERS=<COMMA_SEPARATED_LIST>
# Destination path on the remote host for media backups
MEDIA_DEST=<PATH_TO_REMOTE_MEDIA_BACKUP_DIRECTORY>