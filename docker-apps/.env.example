# ==============================================================================
# ENVIRONMENT VARIABLE TEMPLATE
# Copy this file to '.env' and update with your specific server details.
# Run 'docker compose config' from this directory after editing to validate
# variable expansion and paths. Keep the copied '.env' private; it is ignored
# by Git and contains service credentials.
# ==============================================================================

# --- System Settings ---
TZ=America/Los_Angeles

# --- Base Directory for Apps ---
# The parent directory on your host where you store all app configuration data
BASE_APPDATA=/var/lib/docker/appdata

# --- Pi-hole Settings ---
PIHOLE_HOSTNAME=pihole
PIHOLE_PASSWORD= # <SET_YOUR_PIHOLE_ADMIN_PASSWORD>
PIHOLE_VIRTUAL_HOST=pihole,pihole.internal

# --- Secrets ---
# Obtain these from your respective service provider accounts
MYSQL_ROOT_PASSWORD= # <SET_ROOT_DATABASE_PASSWORD>
MYSQL_PASSWORD= # <SET_APPLICATION_DATABASE_PASSWORD>
MYSQL_DATABASE= #<SET YOUR PREFERRED DATABASE NAME HERE>
MYSQL_USER= #<SET_YOUR_PREFERRED_USERNAME>

# --- Path Mappings: Host -> Container ---
# Define the absolute path on your HOST machine for each service.

# App Data Paths
PATH_NEXTCLOUD_DB=${BASE_APPDATA}/nextcloud/db
PATH_NEXTCLOUD_APP=${BASE_APPDATA}/nextcloud/app


# Nextcloud Mobile Upload Paths
PATH_NEXTCLOUD_MOBILE_USER1_PHOTOS=<PATH_TO_USER1_PHOTOS_ON_HOST>
PATH_NEXTCLOUD_MOBILE_USER2_PHOTOS=<PATH_TO_USER2_PHOTOS_ON_HOST>

# --- Internal Container Path Mapping ---
# These paths are dictated by the Docker image requirements.
# Do not change these unless you are modifying the service image!

CONT_CONFIG=/config
CONT_NEXTCLOUD_DB=/var/lib/mysql
CONT_NEXTCLOUD_APP=/var/www/html

# Internal path mapping for user photos inside Nextcloud
# Replace <YOUR_NEXTCLOUD_USERNAME_X> with the actual username inside your Nextcloud instance
CONT_NEXTCLOUD_USER1_PHOTOS=${CONT_NEXTCLOUD_APP}/data/<YOUR_NEXTCLOUD_USERNAME_1>/files/Photos
CONT_NEXTCLOUD_USER2_PHOTOS=${CONT_NEXTCLOUD_APP}/data/<YOUR_NEXTCLOUD_USERNAME_2>/files/Photos

#Cloudflare tunnel token
CLOUDFLARE_TUNNEL_TOKEN= # <SET_YOUR_CLOUDFLARE_TUNNEL_TOKEN>
#Tailscale auth key
TS_AUTH_KEY= # <SET_YOUR_TAILSCALE_AUTH_KEY>
TS_HOSTNAME= # <SET_YOUR_TAILSCALE_HOSTNAME>
TS_ROUTES= # <OPTIONAL: SET_YOUR_TAILSCALE_ROUTES_IF_NEEDED>; eg. 192.168.1.0/24

# --- MagicMirror ---

# Host path where MagicMirror's config.js and generated data will live.
# Created automatically on first container start if it doesn't exist.
PATH_MAGICMIRROR_CONFIG=/var/lib/docker/appdata/magicmirror/config
CONT_MAGICMIRROR_CONFIG=/opt/magic_mirror/config

# Where 3rd-party modules (MMM-Wallpaper, MMM-Remote-Control, etc.) get
# git-cloned/npm-installed. Persisted so they survive container recreation.
PATH_MAGICMIRROR_MODULES=/var/lib/docker/appdata/magicmirror/modules
CONT_MAGICMIRROR_MODULES=/opt/magic_mirror/modules

# Host path to the Nextcloud folder that supplies MMM-Wallpaper's photo source.
# This must be a real Nextcloud *folder* under Files (Photos app "Albums" are
# virtual and have no filesystem path, so they won't work here).
# Path structure: <nextcloud data dir>/<nextcloud username>/files/<folder path>
PATH_NEXTCLOUD_WALLPAPERS=<PATH_TO_NEXTCLOUD_WALLPAPER_FOLDER>

# Mount point inside the magicmirror container. Reference this same path
# in config.js as the MMM-Wallpaper "local:" source, e.g.:
#   source: "local:/opt/magic_mirror/wallpapers"
CONT_MAGICMIRROR_WALLPAPERS=/opt/magic_mirror/wallpapers